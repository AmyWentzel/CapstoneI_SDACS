        "func": "const delayMs = Number(flow.get('capture_delay_ms') ?? 5000);\nconst recordSeconds = Number(flow.get('capture_record_seconds') ?? 20);\nconst stamp = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0,14);\nconst requestId = `capture_${stamp}`;\nmsg.topic = 'sdacs/group/all/cmd';\nmsg.payload = {cmd:'start_capture', request_id:requestId, delay_ms:delayMs, record_seconds:recordSeconds};\nflow.set('last_request_id', requestId);\nreturn msg;",
