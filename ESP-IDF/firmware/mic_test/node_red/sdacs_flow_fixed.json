        "func": "const p = msg.payload || {};\nconst topic = msg.topic || '';\nconst node_id = p.node_id || topic.split('/')[2] || 'unknown';\nif (topic.endsWith('/capture_complete') || p.record_type === 'capture_complete') {\n    let events = flow.get('capture_events') || [];\n    events.unshift({\n        time: new Date().toLocaleTimeString(), node_id,\n        request_id: p.request_id || '', state: p.state || '', record_seconds: p.record_seconds || '',\n        raw_bytes: p.raw_bytes || '', wav_bytes: p.wav_bytes || '', metrics_bytes: p.metrics_bytes || '',\n        raw_path: p.raw_path || '', wav_path: p.wav_path || '', metrics_path: p.metrics_path || ''\n    });\n    events = events.slice(0, 20);\n    flow.set('capture_events', events);\n    return [null, {payload: events}];\n}\nlet nodes = flow.get('capture_nodes') || {};\nnodes[node_id] = Object.assign(nodes[node_id] || {}, {\n    node_id,\n    status: p.status || (nodes[node_id] && nodes[node_id].status) || '',\n    state: p.state || p.capture_state || p.mode || (nodes[node_id] && nodes[node_id].state) || '',\n    request_id: p.request_id || (nodes[node_id] && nodes[node_id].request_id) || '',\n    delay_ms: p.delay_ms ?? ((nodes[node_id] && nodes[node_id].delay_ms) || ''),\n    record_seconds: p.record_seconds ?? ((nodes[node_id] && nodes[node_id].record_seconds) || ''),\n    batt_soc_percent: p.batt_soc_percent ?? ((nodes[node_id] && nodes[node_id].batt_soc_percent) || ''),\n    rssi_dbm: p.rssi_dbm ?? ((nodes[node_id] && nodes[node_id].rssi_dbm) || ''),\n    message: p.message || p.reason || (nodes[node_id] && nodes[node_id].message) || '',\n    last_seen: new Date().toLocaleTimeString()\n});\nflow.set('capture_nodes', nodes);\nreturn [{payload:Object.values(nodes).sort((a,b)=>a.node_id.localeCompare(b.node_id))}, null];",
