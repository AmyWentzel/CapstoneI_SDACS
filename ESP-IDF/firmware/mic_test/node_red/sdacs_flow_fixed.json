        "format": "<table style=\"width:100%; border-collapse:collapse;\">\n<thead><tr><th align=\"left\">Node</th><th align=\"left\">State</th><th align=\"left\">FW</th><th align=\"left\">dB SPL</th><th align=\"left\">Peak Hz</th><th align=\"left\">Temp</th><th align=\"left\">RH</th><th align=\"left\">Batt %</th><th align=\"left\">Vbat</th><th align=\"left\">RSSI</th><th align=\"left\">Last seen</th></tr></thead>\n<tbody><tr ng-repeat=\"n in msg.payload\"><td>{{n.node_id}}</td><td>{{n.capture_state || n.status}}</td><td>{{n.fw_version}}</td><td>{{n.db_spl}}</td><td>{{n.f_peak_hz}}</td><td>{{n.temp_c}}</td><td>{{n.rh_percent}}</td><td>{{n.batt_soc_percent}}</td><td>{{n.batt_voltage_v}}</td><td>{{n.rssi_dbm}}</td><td>{{n.last_seen}}</td></tr></tbody>\n</table>",
