    {
        "id": "dec91f724a14b12f",
        "type": "function",
        "z": "e270d71be1b309e9",
        "name": "Normalize latest firmware telemetry",
        "func": "const topic = msg.topic || '';\nconst parts = topic.split('/');\nconst node_id = (msg.payload && (msg.payload.node_id || msg.payload.node)) || parts[2] || 'unknown';\nconst p = msg.payload || {};\nlet type = p.record_type || 'unknown';\nif (topic.endsWith('/features')) type = 'features';\nelse if (topic.endsWith('/temp_humidity')) type = 'temp_humidity';\nelse if (topic.endsWith('/fuel_gauge')) type = 'fuel_gauge';\nelse if (topic.endsWith('/status/heartbeat')) type = 'heartbeat';\n\nconst rec = {\n    timestamp_iso: (typeof p.timestamp === 'string') ? p.timestamp : new Date().toISOString(),\n    timestamp_us: (typeof p.timestamp === 'number') ? p.timestamp : (p.t_us ?? null),\n    node_id,\n    topic,\n    record_type: type,\n    fw_version: p.fw_version ?? '',\n    status: p.status ?? '',\n    capture_state: p.capture_state ?? p.state ?? p.mode ?? '',\n    seq: p.seq ?? '',\n    n: p.n ?? '',\n    rms: p.rms ?? null,\n    dbfs: p.dbfs ?? null,\n    db_spl: p.db_spl ?? null,\n    f_peak_hz: p.f_peak_hz ?? p.fft_peak_Hz ?? p.fft_peak_hz ?? null,\n    p2p_raw: p.p2p_raw ?? null,\n    zeros: p.zeros ?? null,\n    temp_c: p.temp_c ?? null,\n    rh_percent: p.rh_percent ?? null,\n    batt_soc_percent: p.batt_soc_percent ?? p.soc_percent ?? null,\n    batt_voltage_v: p.batt_voltage_v ?? p.voltage_v ?? null,\n    batt_charge_rate_pct_per_hr: p.batt_charge_rate_pct_per_hr ?? p.charge_rate_percent_per_hr ?? null,\n    batt_sample_count: p.batt_sample_count ?? p.sample_count ?? null,\n    batt_error_count: p.batt_error_count ?? p.error_count ?? null,\n    batt_valid: p.batt_valid ?? p.valid ?? null,\n    rssi_dbm: p.rssi_dbm ?? null,\n    free_heap: p.free_heap ?? null,\n    wifi_connected: p.wifi_connected ?? null,\n    mqtt_connected: p.mqtt_connected ?? null,\n    ota_ready: p.ota_ready ?? null,\n    ota_in_progress: p.ota_in_progress ?? null,\n    err: p.err ?? '',\n    raw_json: JSON.stringify(p)\n};\n\nlet latest = flow.get('sdacs_latest') || {};\nlatest[node_id] = Object.assign(latest[node_id] || {}, rec, {last_seen: new Date().toLocaleTimeString()});\nflow.set('sdacs_latest', latest);\n\nmsg.payload = rec;\nreturn [msg, {payload: Object.values(latest).sort((a,b)=>a.node_id.localeCompare(b.node_id))}];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
